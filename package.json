{
  "name": "floorplan",
  "version": "1.2.0",
  "description": "Floorplan for placing lights on floor images and controlling an eDin+ system.",
  "main": "main.js",
  "scripts": {
    "start": "node ./node_modules/electron/cli.js .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "winston": "3.8"
  },
  "build": {
    "appId": "com.modelighting.floorplan",
    "productName": "Floorplan",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "index.html",
      "package.json",
      "src/**/*",
      "assets/**/*",
      "!**/*.log",
      "!**/*.zip"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Floorplan-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "AxiumDND <noreply@github.com>",
      "artifactName": "Floorplan-${version}.${ext}"
    }
  }
}
