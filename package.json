{
  "name": "floorplan",
  "version": "1.1.6",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "net": "^1.0.2",
    "winston": "3.8"
  },
  "build": {
    "appId": "your.app.id",
    "productName": "Floorplan",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/test",
      "!**/*.map",
      "dist/**/*",
      "src/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}